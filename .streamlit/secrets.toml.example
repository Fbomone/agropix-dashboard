# Plantilla de secrets. NO pongas valores reales en este archivo (se versiona).
#
# Local  : copiar a .streamlit/secrets.toml (ignorado por git) y completar.
# Cloud  : pegar este contenido completo en share.streamlit.io ->
#          tu app -> Settings -> Secrets.

# --- Google Sheets ---
CRM_SHEET_ID = "id-del-sheet-de-trabajos"
VENTAS_SHEET_ID = "id-del-sheet-de-ventas"
CRM_TAB = "Trabajos"
VENTAS_TAB = "Ventas"

# --- SendGrid (envio automatico de reportes) ---
# Se acepta esta forma plana o la tabla [sendgrid] del final. Con las dos
# presentes gana la plana.
SENDGRID_API_KEY = "SG.reemplazar"
EMAIL_REMITENTE = "reportes@agropix.com"          # Single Sender verificado en SendGrid
EMAIL_DESTINATARIOS = "dueno@agropix.com,gerente@agropix.com"

# --- Service account de Google: contenido de credentials.json ---
[gcp_service_account]
type = "service_account"
project_id = "reemplazar"
private_key_id = "reemplazar"
private_key = "-----BEGIN PRIVATE KEY-----\nREEMPLAZAR\n-----END PRIVATE KEY-----\n"
client_email = "reemplazar@reemplazar.iam.gserviceaccount.com"
client_id = "reemplazar"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "reemplazar"
universe_domain = "googleapis.com"

# --- Usuarios del dashboard (opcional) ---
# Si esta tabla existe, REEMPLAZA a USUARIOS_AUTORIZADOS de utils/auth.py.
# Sirve para rotar contrasenas sin tocar el codigo ni volver a deployar.
# Generar salt/hash con:  python -m utils.auth "LaPasswordNueva"
#
# [usuarios."dueno@agropix.com"]
# nombre = "Dueño"
# rol = "admin"
# salt = "..."
# hash = "..."

# --- SendGrid, forma alternativa (equivalente a las claves planas de arriba) ---
# [sendgrid]
# api_key = "SG.reemplazar"
# from_email = "reportes@agropix.com"
# destinatarios = "dueno@agropix.com,gerente@agropix.com"

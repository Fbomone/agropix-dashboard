# Plantilla de secrets. NO pongas valores reales en este archivo (se versiona).
#
# Local  : copiar a .streamlit/secrets.toml (ignorado por git) y completar.
# Cloud  : pegar este contenido completo en share.streamlit.io ->
#          tu app -> Settings -> Secrets.
#
# OJO: el cuadro de Secrets de Streamlit Cloud REEMPLAZA todo lo que haya.
# Antes de pegar, copiá lo que ya está cargado para no perder nada.

# --- Acceso a la app (obligatorio: sin esto no entra nadie) ---
# Una sola contrasena para todo el equipo. Entran unicamente los emails de
# EMAILS_AUTORIZADOS (utils/auth.py): poner la clave no habilita a nadie mas.
# Si se filtra, se cambia aca y listo, sin redeploy.
AUTH_PASSWORD = "reemplazar"

# Opcional: contrasena propia para alguien en particular, le gana a la de arriba.
# La clave es el email con "@" y "." pasados a "_", porque TOML no los admite.
# [auth_users]
# francobomone14_gmail_com = "otra-solo-para-franco"

# --- Link del boton "Ver reporte completo" en el mail semanal ---
# Si la app se redeploya con otro nombre, se cambia aca y no en el codigo.
URL_APP = "https://agropix-dashboard-rlugsmactrmmzqtonnbqw9.streamlit.app/"

# --- Google Sheets ---
CRM_SHEET_ID = "id-del-sheet-de-trabajos"
VENTAS_SHEET_ID = "id-del-sheet-de-ventas"
CRM_TAB = "Trabajos"
VENTAS_TAB = "Ventas"

# --- Service account de Google: contenido de credentials.json ---
# En Streamlit Cloud este bloque es OBLIGATORIO: alla no existe credentials.json.
# En local podés dejarlo con placeholders; el codigo detecta que la private_key
# no es real, lo ignora y sigue usando credentials.json.
[gcp_service_account]
type = "service_account"
project_id = "reemplazar"
private_key_id = "reemplazar"
private_key = "-----BEGIN PRIVATE KEY-----\nREEMPLAZAR\n-----END PRIVATE KEY-----\n"
client_email = "reemplazar@reemplazar.iam.gserviceaccount.com"
client_id = "reemplazar"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "reemplazar"
universe_domain = "googleapis.com"
